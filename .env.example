# ========= KALITLAR =========
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# @BotFather dan olingan token. Bot kanalda ADMIN bo'lishi shart (post joylash huquqi bilan)
TELEGRAM_BOT_TOKEN=

# ========= TELEGRAM =========
# Kanal: @kanal_username yoki -100xxxxxxxxxx (yopiq kanal uchun)
CHANNEL_ID=@beka_mlbb
# Sizning shaxsiy chat ID (hisobot, xato va qoralamalar shu yerga keladi). @userinfobot dan bilish mumkin
ADMIN_CHAT_ID=

# ========= KONTENT =========
RUBRIC=Har kuni 1 ta predmet
LANGUAGE=o'zbek (lotin yozuvi)
CHANNEL_NAME=Beka MLBB
# Har post oxiridagi havola
SIGNATURE_TEXT=Arzon donat qilish
SIGNATURE_URL=https://t.me/Bekdonatbot
# Rasmlar pastidagi yozuv
IMAGE_FOOTER=Arzon donat: @Bekdonatbot

# ========= META TAHLILI =========
# Geroylar holati, reyting ban/pick %, MPL turnir statistikasi (manba: mlbbhub.com)
# Har META_EVERY_DAYS kunda YOKI yangi patch chiqqanda, META_POST_TIME da chiqadi
META_ENABLED=true
META_EVERY_DAYS=3
META_POST_TIME=21:00
META_MPL_REGIONS=ph,id,my

# ========= QISMLAR =========
# Rasm va audio generatsiya QILINMAYDI — internetdan (MLBB Wiki) topiladi.
# Post DOIM rasm + matn bitta xabarda (matn 1024 belgigacha).
# Rasm topilmasa media/default.png (kanal logosi/banneri) qo'yiladi — uni albatta qo'ying!
# O'z rasmingiz/audiongiz bo'lsa: media/ papkaga mavzu nomi bilan qo'ying (media/blade-of-despair.png)
# Audio kerak bo'lmasa: ENABLE_AUDIO=false
ENABLE_AUDIO=false

# ========= MODELLAR =========
GEMINI_TEXT_MODEL=gemini-3.5-flash
# Bepul tarif: har model kuniga ~20 so'rov. Limit tugasa shu ro'yxat bo'yicha keyingisiga o'tadi
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-lite-latest

# ========= VAQT =========
TIMEZONE=Asia/Tashkent
POST_TIME=20:00
# Post vaqtidan necha daqiqa oldin tayyorlashni boshlash
PREPARE_MINUTES_BEFORE=20
# Post vaqtidan necha daqiqa oldin admin'ga "Qayta tayyorlash" tugmasi bilan yuboriladi
PREVIEW_MINUTES_BEFORE=10
MAX_REGENERATIONS=5

# ========= SIFAT NAZORATI =========
# Minimal ball (1-10). Undan past bo'lsa post kanalga chiqmaydi, qoralama admin'ga yuboriladi
QC_MIN_SCORE=7
QC_MAX_ROUNDS=2
